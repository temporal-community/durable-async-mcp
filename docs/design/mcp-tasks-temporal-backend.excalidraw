      "fontSize": 12,
      "fontFamily": 3,
      "text": "Generic task handlers (server.py)\n\u2022 on_call_tool     -> backend.start()\n\u2022 on_tasks_get     -> backend.get_state()\n\u2022 on_tasks_result  -> get_state -> push elicitation -> submit_input -> wait_result\n\u2022 on_tasks_cancel  -> backend.cancel()",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "g2",
      "originalText": "Generic task handlers (server.py)\n\u2022 on_call_tool     -> backend.start()\n\u2022 on_tasks_get     -> backend.get_state()\n\u2022 on_tasks_result  -> get_state -> push elicitation -> submit_input -> wait_result\n\u2022 on_tasks_cancel  -> backend.cancel()",
      "lineHeight": 1.25,
      "baseline": 10

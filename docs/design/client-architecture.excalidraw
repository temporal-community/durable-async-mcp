      "roundness": null,
      "seed": 1371,
      "version": 1,
      "versionNonce": 1378,
      "text": "@workflow.signal\ndef elicitation_received(self, details): ...\n\n@workflow.signal\ndef user_decision(self, decision): ...\n\n@workflow.query\ndef get_pending_decision(self): ...\n\n# decision held in _pending_decision;\n# activity retries poll for it via\n# get_pending_decision query",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "@workflow.signal\ndef elicitation_received(self, details): ...\n\n@workflow.signal\ndef user_decision(self, decision): ...\n\n@workflow.query\ndef get_pending_decision(self): ...\n\nawait workflow.wait_condition(\n    lambda: self._pending_decision is not None,\n    timeout=timedelta(days=5))",
      "lineHeight": 1.35
    },

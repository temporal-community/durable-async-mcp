      "type": "text",
      "x": 824,
      "y": 3382,
      "width": 652,
      "height": 28,
      "text": "user decides  \u2192  next retry: query returns 'approve'  \u2192  returns ElicitResult\ncancels tasks/result connection per MCP spec  \u2192  resumes polling  \u2713",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#1a4a1a",
